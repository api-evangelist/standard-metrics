          "name": "Get custom column values",
          "request": {
            "name": "Get custom column values",
            "description": {
              "content": "Retrieve custom column values for companies. Includes column metadata, values, and company associations.\n\n**Notes:**\n- If no company is specified, returns custom column data for all companies.\n\n**Permissions:**\n- User must be authenticated via OAuth.\n- User must have access to the metrics data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "custom-columns",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
