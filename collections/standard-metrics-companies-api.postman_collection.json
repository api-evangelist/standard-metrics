              "raw": "{\n  \"firm_sector\": \"<string>\",\n  \"investment_lead_id\": \"<string>\",\n  \"city\": \"<string>\",\n  \"description\": \"<string>\",\n  \"fiscal_year_end\": \"<string>\",\n  \"name\": \"<string>\",\n  \"sector\": \"<string>\",\n  \"website\": \"<string>\"\n}",
