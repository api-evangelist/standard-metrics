        {
          "id": "005b8968-cd6c-4e24-8501-5f44f4c19435",
          "name": "Upload company logo",
          "request": {
            "name": "Upload company logo",
            "description": {
              "content": "Upload a new logo for an offline company. Replaces any existing logo.\n\n**Notes:**\n- File size limit: 5 MB maximum.\n- Logo is owned by the firm since this action is only available for offline companies.\n- Accepted file types:\n    - JPEG images (.jpg, .jpeg)\n    - PNG images (.png)\n    - GIF images (.gif)\n    - WEBP images (.webp)\n\n**Permissions:**\n- User must be authenticated via OAuth.\n- User must have access to the company.\n- User must have ADMIN or EDITOR role.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "companies",
                ":company_id",
                "logo",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
