          "name": "Download document",
          "request": {
            "name": "Download document",
            "description": {
              "content": "Download a specific document by redirecting to signed URL. Provides temporary access to securely stored documents.\n\nThe signed URL expires after 1 hour. After expiration, a new request must be made to obtain a fresh download link.\n\n**Permissions:**\n- User must be authenticated via OAuth.\n- User must have access to the document.",
              "type": "text/plain"
            },
